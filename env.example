# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_channel_or_chat_id

# Tickers to watch, comma-separated.
# For currency pairs (Pocket Option style), use yfinance's forex format: XXXYYY=X
# These are the 7 major pairs:
WATCHLIST=EURUSD=X,GBPUSD=X,USDJPY=X,USDCHF=X,AUDUSD=X,USDCAD=X,NZDUSD=X

# How often to scan (minutes)
SCAN_INTERVAL_MINUTES=5

# Minimum signal score (0-100) required to send an alert
MIN_SIGNAL_SCORE=65

# How long to wait before checking if a signal was a WIN or LOSS (minutes)
OUTCOME_CHECK_MINUTES=30

# Minimum price move (percent) required to count as a WIN or LOSS
# Smaller moves are marked FLAT (no clear result)
OUTCOME_THRESHOLD_PCT=0.3
